# Copy to .env for local runs (never commit .env). Leave DATABASE_URL/PROJECT_ID empty
# to run fully in-memory with no cloud at all.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/antarctica?sslmode=require
PROJECT_ID=your-gcp-project-id
REGION=us-central1
SCAN_TOPIC=scans
VERTEX_EMBED_MODEL=text-embedding-005
VERTEX_LLM_MODEL=gemini-2.5-flash
MAX_SCAN_ATTEMPTS=3
